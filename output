// AIHome OpenClaw-Test baseline hardening.
// Pinned source/release: OpenClaw v2026.7.1-2 / commit 0790d9f593ad30c940ed93b5872a8cf6d6f3cf8c.
// Do not widen tools/plugins/MCP/providers without a new audit.
{
  gateway: {
    mode: "local",
    bind: "loopback",
  },

  agents: {
    defaults: {
      model: {
        primary: "google/gemini-3.6-flash",
        fallbacks: [],
      },
      skills: [],
      subagents: {
        maxConcurrent: 1,
        runTimeoutSeconds: 300,
      },
    },
  },

  // OpenClaw v2026.7.1-2 resolves forward-compatible Gemini models by
  // cloning a Google catalog template. Keep the explicit Gemini 3.6 row
  // transport-complete so the resolver cannot lose Google's API/base URL
  // when this configured model entry is selected.
  models: {
    mode: "merge",
    providers: {
      google: {
        baseUrl: "https://generativelanguage.googleapis.com/v1beta",
        api: "google-generative-ai",
        models: [
          {
            id: "gemini-3.6-flash",
            name: "Gemini 3.6 Flash",
            reasoning: true,
            input: ["text", "image"],
            cost: {
              input: 0,
              output: 0,
              cacheRead: 0,
              cacheWrite: 0,
            },
            contextWindow: 1048576,
            maxTokens: 65536,
          },
        ],
      },
    },
  },

  tools: {
    profile: "minimal",
    allow: ["group:memory", "session_status"],
    deny: [
      "group:runtime",
      "group:fs",
      "group:web",
      "group:ui",
      "group:automation",
      "group:messaging",
      "group:nodes",
      "group:agents",
      "group:media",
      "group:plugins",
      "sessions_spawn",
      "subagents",
      "cron",
      "browser",
      "canvas",
      "exec",
      "process",
      "code_execution",
      "gateway",
      "message",
    ],
    codeMode: { enabled: false },
    agentToAgent: { enabled: false },
    elevated: { enabled: false },
    loopDetection: {
      enabled: true,
      historySize: 30,
      warningThreshold: 10,
      criticalThreshold: 20,
      globalCircuitBreakerThreshold: 30,
      detectors: {
        genericRepeat: true,
        knownPollNoProgress: true,
        pingPong: true,
      },
    },
  },

  // Google is the only explicitly enabled bundled provider plugin for TEST.
  // No channel, tool, MCP, or external plugin is enabled by this setting.
  plugins: {
    enabled: true,
    allow: ["google"],
    entries: {
      google: {
        enabled: true,
      },
    },
  },

  // MCP/ACP bridge intentionally disabled by omission.
  skills: {
    load: {
      extraDirs: [],
      watch: false,
    },
    install: {
      allowUploadedArchives: false,
    },
  },

  cron: {
    enabled: false,
  },
}
