name: aihome-openclaw-test

services:
  openclaw:
    image: ghcr.io/openclaw/openclaw:2026.7.1-2-slim@sha256:8789721d2e9b24b780a1504b56deb4c6bd5c7dbf96a1dd117e7c45c2ed72c8ac
    container_name: aihome-openclaw-test
    restart: unless-stopped
    init: true
    mem_limit: 4g
    memswap_limit: 8g
    cpus: 1.50
    pids_limit: 256
    stop_grace_period: 30s
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      TZ: ${AIHOME_TZ:-Asia/Ho_Chi_Minh}
      NODE_OPTIONS: --max-old-space-size=1536
      OPENCLAW_STATE_DIR: /data/state
      OPENCLAW_CONFIG_PATH: /data/config/openclaw.json5
    ports:
      - "127.0.0.1:18789:18789"
    volumes:
      - /opt/aihome-test/openclaw/state:/data/state
      - /opt/aihome-test/openclaw/workspace:/data/workspace
      - /opt/aihome-test/openclaw/runtime-config:/data/config
      - /opt/aihome-test/source/config/openclaw/openclaw.json5:/data/source-config/openclaw.json5:ro
    command:
      - sh
      - -lc
      - >-
        set -eu;
        cp /data/source-config/openclaw.json5 /data/config/openclaw.json5;
        exec node openclaw.mjs gateway run
