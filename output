=== COMPOSE CONFIG ===
name: aihome-openclaw-test
services:
  openclaw:
    cap_drop:
      - ALL
    cpus: 1.5
    command:
      - sh
      - -lc
      - set -eu; cp /data/source-config/openclaw.json5 /data/config/openclaw.json5;
        exec node openclaw.mjs gateway run
    container_name: aihome-openclaw-test
    environment:
      NODE_OPTIONS: --max-old-space-size=1536
      OPENCLAW_CONFIG_PATH: /data/config/openclaw.json5
      OPENCLAW_STATE_DIR: /data/state
      TZ: Asia/Ho_Chi_Minh
    image: ghcr.io/openclaw/openclaw:2026.7.1-2-slim@sha256:8789721d2e9b24b780a1504b56deb4c6bd5c7dbf96a1dd117e7c45c2ed72c8ac
    init: true
    mem_limit: "3221225472"
    memswap_limit: "3221225472"
    networks:
      default: null
    pids_limit: 256
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 18789
        published: "18789"
        protocol: tcp
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    stop_grace_period: 30s
    volumes:
      - type: bind
        source: /opt/aihome-test/openclaw/state
        target: /data/state
        bind: {}
      - type: bind
        source: /opt/aihome-test/openclaw/workspace
        target: /data/workspace
        bind: {}
      - type: bind
        source: /opt/aihome-test/openclaw/runtime-config
        target: /data/config
        bind: {}
      - type: bind
        source: /opt/aihome-test/source/config/openclaw/openclaw.json5
        target: /data/source-config/openclaw.json5
        read_only: true
        bind: {}
networks:
  default:
    name: aihome-openclaw-test_default
