name: AIHome OpenClaw TEST Box

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: openclaw-test-box
  cancel-in-progress: true

jobs:
  deploy-test-box:
    name: Deploy OpenClaw TEST on Box
    runs-on:
      - self-hosted
      - linux
      - x64
      - aihome-box-test
    timeout-minutes: 15
    env:
      EXPECTED_BRANCH: Openclaw-Test
      SOURCE_DIR: /opt/aihome-test/source

    steps:
      - name: Checkout Openclaw-Test
        uses: actions/checkout@v4
        with:
          ref: Openclaw-Test
          clean: true

      - name: Verify runner and source
        shell: bash
        run: |
          set -euo pipefail
          test "${GITHUB_REF_NAME}" = "${EXPECTED_BRANCH}"
          test -d "${SOURCE_DIR}"
          test -f compose/openclaw.yml
          test -f config/openclaw/openclaw.json5
          echo "RUNNER=$(hostname)"
          echo "COMMIT=$(git rev-parse HEAD)"

      - name: Sync Openclaw-Test to TEST source
        shell: bash
        run: |
          set -euo pipefail
          rsync -a --delete \
            --exclude='.git/' \
            ./ "${SOURCE_DIR}/"

      - name: Validate pinned runtime configuration
        working-directory: /opt/aihome-test/source
        shell: bash
        run: |
          set -euo pipefail
          docker compose -f compose/openclaw.yml config >/tmp/aihome-openclaw-compose-test.yml
          grep -Fq 'mem_limit: 4g' /tmp/aihome-openclaw-compose-test.yml
          grep -Fq 'memswap_limit: 8g' /tmp/aihome-openclaw-compose-test.yml
          grep -Fq 'cpus: 1.50' /tmp/aihome-openclaw-compose-test.yml
          grep -Fq 'pids_limit: 256' /tmp/aihome-openclaw-compose-test.yml

      - name: Restart OpenClaw TEST
        working-directory: /opt/aihome-test/source
        shell: bash
        run: |
          set -euo pipefail
          docker compose -f compose/openclaw.yml up -d --force-recreate

      - name: Runtime health check
        working-directory: /opt/aihome-test/source
        shell: bash
        run: |
          set -euo pipefail
          for i in $(seq 1 12); do
            if docker inspect --format '{{.State.Status}}' aihome-openclaw-test 2>/dev/null | grep -Fxq running; then
              docker compose -f compose/openclaw.yml ps
              echo 'RUNTIME_HEALTH=PASS'
              exit 0
            fi
            sleep 5
          done
          docker compose -f compose/openclaw.yml ps -a
          echo 'RUNTIME_HEALTH=FAIL'
          exit 1

      - name: Failure diagnostics
        if: failure()
        working-directory: /opt/aihome-test/source
        shell: bash
        run: |
          set +e
          echo '=== docker compose ps -a ==='
          docker compose -f compose/openclaw.yml ps -a
          echo '=== container state ==='
          docker inspect aihome-openclaw-test --format '{{json .State}}'
          echo '=== container logs (last 300 lines) ==='
          docker logs --tail 300 aihome-openclaw-test

      - name: Result
        if: always()
        shell: bash
        run: |
          echo "AIHOME_BOX_RESULT=See job conclusion"
          echo "COMMIT=${GITHUB_SHA}"
          echo "RUNNER=$(hostname)"
